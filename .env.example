# Copy this file to `.env` (in the same folder) and fill in the real values.
# Never commit `.env` to source control.

# --- Twilio account ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# --- Twilio Voice ---
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+19377453209

# --- FCM push (created during Firebase setup; see DOCUMENTATION.md) ---
# Leave blank to disable inbound push handling. Outbound calls still work.
TWILIO_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Server ---
BACKEND_PORT=3000
# Set NODE_ENV=development to bypass Twilio webhook signature validation
# (useful when ngrok-rewriting headers. NEVER use in production.)
NODE_ENV=development
